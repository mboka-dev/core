{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "communes.schema.json",
  "title": "Communes",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nom", "departement", "aliases", "verification"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "nom": { "type": "string", "minLength": 2 },
          "departement": { "$ref": "common.schema.json#/$defs/id", "description": "id of the parent département" },
          "aliases": { "$ref": "common.schema.json#/$defs/aliases" },
          "validFrom": { "type": "string", "format": "date" },
          "validUntil": { "type": "string", "format": "date" },
          "replacedBy": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "verification": { "$ref": "common.schema.json#/$defs/verification" }
        }
      }
    }
  }
}
