{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "numerotation.schema.json",
  "title": "Plan de numérotation +242",
  "type": "object",
  "required": ["countryCode", "nationalNumberLength", "verification", "prefixes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "countryCode": { "const": "242" },
    "nationalNumberLength": { "type": "integer", "minimum": 6, "maximum": 12 },
    "nationalGrouping": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "description": "Digit groups used for display, e.g. [2,3,2,2] -> 06 123 45 67"
    },
    "verification": { "$ref": "common.schema.json#/$defs/verification" },
    "prefixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prefix", "type", "verification"],
        "additionalProperties": false,
        "properties": {
          "prefix": { "type": "string", "pattern": "^[0-9]{1,4}$" },
          "type": { "enum": ["mobile", "fixe", "special"] },
          "operator": { "type": "string" },
          "mobileMoney": { "type": "string", "description": "Mobile money service tied to the operator (v0.4)" },
          "note": { "type": "string" },
          "verification": { "$ref": "common.schema.json#/$defs/verification" },
          "ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["start", "end"],
              "additionalProperties": false,
              "properties": {
                "start": { "type": "string", "pattern": "^[0-9]{9}$" },
                "end": { "type": "string", "pattern": "^[0-9]{9}$" }
              }
            },
            "description": "Plages exactes de numéros nationaux à neuf chiffres lorsque le préfixe seul est trop large."
          }
        }
      }
    },
    "specialNumbers": {
      "type": "array",
      "description": "Numéros courts de service, distincts des numéros nationaux à 9 chiffres parsés par phone.parse.",
      "items": {
        "type": "object",
        "required": ["code", "type", "description", "verification"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^(?:[0-9]{3}|[0-9]{2}XXX)$" },
          "type": { "enum": ["customer_service", "public_service", "reserved", "value_added"] },
          "description": { "type": "string", "minLength": 1 },
          "verification": { "$ref": "common.schema.json#/$defs/verification" }
        }
      }
    }
  }
}
