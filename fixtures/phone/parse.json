{
  "function": "phone.parse",
  "status": "active",
  "description": "Parse any common way of writing a +242 number. `expected` is matched partially.",
  "cases": [
    { "name": "national, grouped with spaces", "input": "06 123 45 67",
      "expected": { "valid": true, "e164": "+242061234567", "national": "06 123 45 67", "international": "+242 06 123 45 67", "operator": "MTN Congo", "reason": null } },
    { "name": "MTN range officially assigned in 2024", "input": "06 100 12 34",
      "expected": { "valid": true, "e164": "+242061001234", "operator": "MTN Congo", "type": "mobile" } },
    { "name": "Congo Telecom mobile in an assigned 02 range", "input": "02 400 12 34",
      "expected": { "valid": true, "e164": "+242024001234", "operator": "Congo Telecom", "type": "mobile" } },
    { "name": "Congo Telecom mobile in another assigned 02 range", "input": "02 666 12 34",
      "expected": { "valid": true, "e164": "+242026661234", "operator": "Congo Telecom", "type": "mobile" } },
    { "name": "start of the 02 550–589 allocation", "input": "02 550 12 34",
      "expected": { "valid": true, "e164": "+242025501234", "operator": "Congo Telecom" } },
    { "name": "end of the 02 550–589 allocation", "input": "02 589 12 34",
      "expected": { "valid": true, "e164": "+242025891234", "operator": "Congo Telecom" } },
    { "name": "start of the 02 600–615 allocation", "input": "02 600 12 34",
      "expected": { "valid": true, "e164": "+242026001234", "operator": "Congo Telecom" } },
    { "name": "end of the 02 600–615 allocation", "input": "02 615 12 34",
      "expected": { "valid": true, "e164": "+242026151234", "operator": "Congo Telecom" } },
    { "name": "end of the 02 666–699 allocation", "input": "02 699 12 34",
      "expected": { "valid": true, "e164": "+242026991234", "operator": "Congo Telecom" } },
    { "name": "unassigned 02 number outside published ranges", "input": "02 500 00 00",
      "expected": { "valid": false, "reason": "unknown_prefix" } },
    { "name": "E.164", "input": "+242061234567",
      "expected": { "valid": true, "e164": "+242061234567", "operator": "MTN Congo" } },
    { "name": "00 international prefix", "input": "00242 05 987 65 43",
      "expected": { "valid": true, "e164": "+242059876543", "operator": "Airtel" } },
    { "name": "country code without plus, dots", "input": "242 06.123.45.67",
      "expected": { "valid": true, "e164": "+242061234567" } },
    { "name": "parentheses and dashes", "input": "(+242) 06-123-45-67",
      "expected": { "valid": true, "e164": "+242061234567" } },
    { "name": "fixed geographic number in Brazzaville", "input": "22 281 00 00",
      "expected": { "valid": true, "e164": "+242222810000", "operator": null, "type": "fixe" } },
    { "name": "national, no separators", "input": "061234567",
      "expected": { "valid": true, "national": "06 123 45 67" } },
    { "name": "surrounding whitespace", "input": "  06 123 45 67  ",
      "expected": { "valid": true, "e164": "+242061234567" } },
    { "name": "leading zero dropped", "input": "6 123 45 67",
      "expected": { "valid": false, "e164": null, "operator": null, "reason": "length" } },
    { "name": "too short", "input": "06 123 45 6",
      "expected": { "valid": false, "reason": "length" } },
    { "name": "too long", "input": "06 123 45 678",
      "expected": { "valid": false, "reason": "length" } },
    { "name": "unknown prefix", "input": "09 123 45 67",
      "expected": { "valid": false, "reason": "unknown_prefix" } },
    { "name": "foreign number", "input": "+33 6 12 34 56 78",
      "expected": { "valid": false, "reason": "foreign_number" } },
    { "name": "letters", "input": "06 123 45 6x",
      "expected": { "valid": false, "reason": "invalid_characters" } },
    { "name": "empty string", "input": "",
      "expected": { "valid": false, "reason": "empty" } },
    { "name": "only separators", "input": " - . ",
      "expected": { "valid": false, "reason": "empty" } },
    { "name": "short service code is not a nine-digit subscriber number", "input": "117",
      "expected": { "valid": false, "reason": "length" } },
    { "name": "non-string input throws", "input": 61234567, "expectedError": true }
  ]
}
