{
  "name": "mboka-core-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-data.mjs",
    "sync": "node scripts/sync-data.mjs",
    "typecheck": "npm run typecheck -w packages/js",
    "build": "npm run build -w packages/js",
    "test:js": "npm test -w packages/js",
    "test:py": "cd packages/py && python -m pytest -q",
    "check": "npm run validate && npm run sync -- --check && npm run typecheck && npm run test:js && npm run test:py",
    "version:set": "node scripts/set-version.mjs",
    "lint": "eslint . && ruff check packages/py",
    "format": "prettier --write . && ruff format packages/py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
