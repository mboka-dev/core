{
  "name": "mboka-core-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-data.mjs",
    "sync": "node scripts/sync-data.mjs",
    "typecheck": "npm run typecheck -w packages/js",
    "build": "npm run build -w packages/js",
    "test:js": "npm test -w packages/js",
    "check": "npm run validate && npm run sync -- --check && npm run typecheck && npm run test:js"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}